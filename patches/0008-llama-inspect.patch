index 0000000..36cb508
--- /dev/null
+++ b/tools/inspect/inspect.h
@@ -0,0 +1,20 @@
+// llama-inspect: llama.cpp's inference, opened up.
+//
+// The server exposes what a chat client needs: text, top-n logprobs, timings.
+// This tool exposes what an interpretability experiment needs: the full logit
+// vector at any position, the intermediate tensors of the graph (FFN
+// activations, attention outputs, the embedding), and the ability to change
+// those tensors in place and see what the model does next.
+//
+// It runs the model itself, on one context, one request at a time, so a
+// capture is always the whole batch and a tensor's second dimension is always
+// the token index. That is the property the server cannot offer, because its
+// scheduler interleaves slots.
+//
+// SPDX-License-Identifier: MIT
+
+#pragma once
+
+// Runs the tool; defined in inspect.cpp. main.cpp is a shim so the PS5 build
+// can wrap main() without touching this file.
+int llama_inspect_main(int argc, char ** argv);
diff --git a/tools/inspect/main.cpp b/tools/inspect/main.cpp
new file mode 100644
index 0000000..4c6018c
--- /dev/null
+++ b/tools/inspect/main.cpp
@@ -0,0 +1,5 @@
+#include "inspect.h"
+
+int main(int argc, char ** argv) {
+    return llama_inspect_main(argc, argv);
+}
