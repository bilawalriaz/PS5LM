+# llama-inspect: logits, activations and interventions over HTTP
+#
+# Built with the rest of llama.cpp's tools. On the PS5 it is a payload built by
+# scripts/build-llama.sh; on a workstation it is a normal cmake target.
+
+set(TARGET llama-inspect)
+
+add_executable(${TARGET} main.cpp inspect.cpp)
+
+install(TARGETS ${TARGET} RUNTIME)
+
+target_link_libraries(${TARGET} PRIVATE llama-common cpp-httplib ${CMAKE_THREAD_LIBS_INIT})
+target_include_directories(${TARGET} PRIVATE ${PROJECT_SOURCE_DIR}/vendor)
+target_compile_features(${TARGET} PRIVATE cxx_std_17)
